# Dependências (ambiente local)
node_modules/
backend/node_modules/
frontend/node_modules/

# Banco de dados
backend/prisma/**/*.db
backend/prisma/**/*.db-journal
backend/prisma/**/*.db-shm
backend/prisma/**/*.db-wal
backend/*.db
backend/*.db-journal
backend/*.db-shm
backend/*.db-wal

# Variáveis de ambiente
.env
backend/.env
frontend/.env

# WhatsApp session
.wwebjs_auth/
.wwebjs_cache/
backend/.wwebjs_auth*/
backend/.wwebjs_cache/

# Uploads (não versionar arquivos de usuários)
uploads/media/*
uploads/rg/*
uploads/temp/*
backend/uploads/media/*
backend/uploads/rg/*
backend/uploads/temp/*
!uploads/media/.gitkeep
!uploads/rg/.gitkeep
!uploads/temp/.gitkeep
!backend/uploads/media/.gitkeep
!backend/uploads/rg/.gitkeep
!backend/uploads/temp/.gitkeep

# Build
backend/dist/
frontend/dist/

# Logs
*.log
*.err
npm-debug.log*

# OS
.DS_Store
Thumbs.db
