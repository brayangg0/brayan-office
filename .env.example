# ─── Banco de Dados ────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Servidor ──────────────────────────────────────────────────────
PORT=3333
NODE_ENV=development

# ─── Autenticação ──────────────────────────────────────────────────
# IMPORTANTE: troque por uma string longa e aleatória em produção!
JWT_SECRET=mude_esta_chave_secreta_em_producao_use_32_chars_minimo

# ─── Frontend (CORS) ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# OpenAI - Resposta Automatica com IA
# Crie uma chave em https://platform.openai.com/api-keys e cole aqui.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp
# false = o servidor nao conecta o WhatsApp sozinho ao iniciar.
WHATSAPP_AUTO_START=false
# Intervalo base entre envios em massa/campanhas. O sistema soma alguns segundos aleatorios.
WHATSAPP_SEND_DELAY_MS=20000
# false = ao conectar no QR, nao busca todos os grupos automaticamente.
WHATSAPP_SYNC_GROUPS_ON_READY=false
# Timeout da sincronizacao manual de grupos.
WHATSAPP_SYNC_TIMEOUT_MS=25000
